  stock        Int
  sku          String?   @db.VarChar(255)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model products {
  id                   BigInt       @id @default(autoincrement())
  product_code         String       @db.VarChar(255)
  parent_id            Int?
  product_name         String       @db.VarChar(255)
  slug                 String?      @unique(map: "slug") @db.VarChar(255)
  product_description  String?      @db.LongText
  key_specifications   String?      @db.LongText
  packaging            String?      @db.LongText
  warranty             String?      @db.LongText
  category_id          Int?
  delivery_target_days String?      @db.VarChar(255)
  discount             Decimal?     @default(0.00) @db.Decimal(10, 2)
  actual_price         Decimal?     @default(0.00) @db.Decimal(12, 2)
  sell_price           Decimal?     @default(0.00) @db.Decimal(12, 2)
  available_quantity   BigInt       @default(0)
  stock_quantity       BigInt       @default(0)
  brand_id             Int?
  product_location     String?      @db.VarChar(255)
  has_variations       Int?
  flash_sale           Int?
  weekly_offer         Int?
  special_offer        Int?
  sell_count           Int?         @default(0)
  today_deals          Int?
  main_image           String?      @db.VarChar(255)
  product_catalogue    String?      @db.VarChar(255)
  status               Int
  created_at           DateTime?    @db.Timestamp(0)
  updated_at           DateTime?    @db.Timestamp(0)

  @@index([product_code], map: "product_code")
}

model promotion_images {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_code     String?   @db.VarChar(255)
  file_path        String?   @db.VarChar(255)
  mobile_file_path String?   @db.VarChar(255)
  is_offer         Int       @default(0)
  status           Int       @default(1) @db.TinyInt
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
}

model provinces {
  id                    BigInt                  @id @default(autoincrement())
  province_name         String                  @db.VarChar(255)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  customer_address_book customer_address_book[]
  set_shipping          set_shipping[]
}

model recommended_products {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id  BigInt
  product_code String    @db.VarChar(255)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@unique([customer_id, product_code], map: "customer_product_unique")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model set_shipping {
  id                    BigInt                  @id @default(autoincrement())
  province_id           BigInt
  city                  String                  @db.VarChar(255)
  shipping_cost         Decimal                 @default(0.00) @db.Decimal(10, 2)
  apply_shipping        Int                     @default(1)
  remarks               String?                 @db.VarChar(255)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  customer_address_book customer_address_book[]
  provinces             provinces               @relation(fields: [province_id], references: [id], onUpdate: Restrict, map: "set_shipping_fk_1")

  @@index([province_id], map: "province")
}

model shipping_carriers {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  address    String    @db.VarChar(255)
  phone      String    @db.VarChar(255)
  type       String?   @db.VarChar(255)
  status     Int
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model storages {
  id         BigInt    @id @default(autoincrement())
  data_type  String    @db.VarChar(255)
  data_id    String    @db.VarChar(100)
  key        String?   @db.VarChar(255)
  value      String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @db.DateTime(0)

  @@index([data_id, value], map: "data_id")
}

model system_settings {
  id         Int       @id @default(autoincrement())
  key        String
  value      String?   @db.Text
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @db.DateTime(0)
}

model users {
  id                 BigInt    @id @default(autoincrement())
  full_name          String    @db.VarChar(255)
  email              String    @unique(map: "users_email_unique") @db.VarChar(255)
  phone              String?   @unique(map: "phone") @db.VarChar(255)
  gender             String?   @db.VarChar(10)
  is_phone_verified  Boolean   @default(false)
  is_email_verified  Boolean   @default(false)
  email_verified_at  DateTime? @db.Timestamp(0)
  status             Boolean   @default(false)
  order_count        Int       @default(0)
  login_medium       String?
  social_id          String?
  password           String    @db.VarChar(255)
  remember_token     String?   @db.VarChar(100)
  profile_photo_path String?   @db.VarChar(2048)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
}

model wishlist {
  id           BigInt    @id @default(autoincrement())
  customer_id  BigInt
  product_code String    @db.VarChar(255)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}
