model customer_address_book {
  id               BigInt       @id @default(autoincrement())
  customer_id      BigInt
  full_name        String       @db.VarChar(255)
  phone            String       @db.VarChar(255)
  province_id      BigInt
  city_id          BigInt
  zone_id          BigInt
  address          String       @db.VarChar(255)
  landmark         String?      @db.VarChar(255)
  address_type     String?      @db.VarChar(255)
  default_shipping String?      @db.VarChar(255)
  default_billing  String?      @db.VarChar(255)
  created_at       DateTime?    @db.Timestamp(0)
  updated_at       DateTime?    @db.Timestamp(0)
  provinces        provinces    @relation(fields: [province_id], references: [id], onUpdate: Restrict, map: "customer_address_book_fk_2")
  set_shipping     set_shipping @relation(fields: [city_id], references: [id], onUpdate: Restrict, map: "customer_address_book_fk_3")
  address_zone     address_zone @relation(fields: [zone_id], references: [id], onUpdate: Restrict, map: "customer_address_book_fk_4")

  @@index([city_id], map: "city")
  @@index([customer_id], map: "customer_id")
  @@index([province_id], map: "province")
  @@index([zone_id], map: "zone_id")
}

