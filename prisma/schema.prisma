model cart {
  id                  BigInt    @id @default(autoincrement())
  customer_id         BigInt?
  province_id         BigInt?
  city_id             BigInt?
  session_id          String?   @db.VarChar(255)
  tax                 Decimal   @default(0.00) @db.Decimal(10, 2)
  shipping_cost       Decimal   @default(0.00) @db.Decimal(10, 2)
  shipping_cost_total Decimal   @default(0.00) @db.Decimal(10, 2)
  subtotal            Decimal   @default(0.00) @db.Decimal(12, 2)
  status              String?   @db.VarChar(255)
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)

  @@index([city_id], map: "city_id")
  @@index([customer_id], map: "customer_id")
  @@index([province_id], map: "province_id")
}

// NOTE: the DB has a real FK (cart_items_fk_1) from cart_items.product_code -> products.product_code,
// but products.product_code is NOT a unique/primary key in the live DB (duplicates exist), so Prisma
// can't model it as a @relation (would require adding @unique, which we must not do per the
// "don't modify the DB structure" rule). Left as a plain scalar column; join manually via product_code
// when needed (e.g. products.findFirst({ where: { product_code } })). Re-apply this fix after every
// `prisma db pull`, since introspection will re-add the @relation line otherwise.
model cart_items {
  id           BigInt    @id @default(autoincrement())
  cart_id      BigInt
  product_code String    @db.VarChar(255)
  quantity     BigInt
  price        Decimal   @default(0.00) @db.Decimal(12, 2)
  actual_price Decimal   @default(0.00) @db.Decimal(12, 2)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@index([product_code], map: "product_code")
}

